#!/bin/sh
# 🔒🏆 GOLDEN-LOCK — git pre-push (23 ส.ค. 69 — เจ้าของสั่ง "ล็อกระบบข่าวกันพลาดเวลาแก้ระบบอื่น")
# ทำงานทุกครั้งที่ push ไป refs/heads/main (ทุก worktree ที่ใช้ .git นี้ — ไม่ว่าจะเป็น Claude/codex/มือ):
#   ถ้ามี commit ในช่วงที่จะ push แตะไฟล์ "ระบบเขียนข่าว" (PROTECTED) → ทุก commit ที่แตะต้องมีรหัสอนุมัติในข้อความ
#   รูปแบบรหัส:  [NEWS-LOCK-APPROVED by <ชื่อผู้อนุมัติ> <วันที่>]   (เจ้าของเท่านั้นที่ให้ได้)
#   ไม่มีรหัส → ❌ ปฏิเสธการ push (ไม่กระทบกิ่งอื่นที่ไม่ใช่ main)
# ติดตั้ง: คัดลอกไฟล์นี้ไป .git/hooks/pre-push ของ repo หลัก (= <git-common-dir>/hooks/pre-push · worktree ทุกตัวใช้ร่วมกัน)
#   ด้วยคำสั่งในบรรทัด "ติดตั้ง/อัปเดต" ด้านล่าง (สคริปต์ติดตั้ง/ตรวจแยกของเดิมถูกถอดออกจาก main แล้ว — ไม่ต้องหา)
# ★ 23 ก.ย. 69 (แคมเปญแก้บั๊ก ข้อ 1 · เจ้าของอนุมัติ) — ด่านเทสข่าว (CFG-03): push ไป refs/heads/main ต้องผ่าน
#   `node scripts/test-news.mjs` (= npm run test:news · รายชื่อ tests/news-suite.json) ด้วย · แดง = ปฏิเสธการ push
#   สวิตช์ฉุกเฉิน: NEWS_TEST_GATE=0 git push ...  (ข้ามเฉพาะด่านเทส ไม่ข้ามรหัสอนุมัติ · พิมพ์คำเตือนทุกครั้ง)
#   รันจากไฟล์บนดิสก์ของ worktree ที่สั่ง push — commit ที่ push ไม่ใช่ HEAD/มีไฟล์แก้ค้าง = พิมพ์เตือน
#   กิ่งที่ยังไม่มี scripts/test-news.mjs = ข้ามด่านเทส (พิมพ์เตือน) · ติดรหัสอนุมัติอยู่แล้ว = ไม่เสียเวลารันเทส
#   ต้นฉบับ = scripts/golden-lock/hooks/pre-push · สำเนาที่ติดตั้งจริง = <git-common-dir>/hooks/pre-push ต้องตรงกันทุกไบต์
#   ติดตั้ง/อัปเดต (Git Bash): cp scripts/golden-lock/hooks/pre-push "$(git rev-parse --git-common-dir)/hooks/pre-push"
#   (tests/news-prepush-gate.test.mjs ตรวจพฤติกรรมไฟล์นี้ใน repo ชั่วคราว + เทียบกับสำเนาที่ติดตั้งถ้ามี)

remote="$1"
PROTECTED='^src/lib/services/autoFlowService\.js|^src/lib/services/autoFlowServiceText\.js|^src/lib/services/summarizeService\.js|^src/lib/services/summarizeServiceText\.js|^src/lib/services/queueService\.js|^src/lib/services/promptMatcher\.js|^src/lib/services/researchService\.js|^src/lib/services/researchVerifier\.js|^src/lib/services/achievementResearch\.js|^src/lib/services/viralFewshot\.js|^src/lib/ai/aiRouter\.js|^src/lib/ai/openai\.js|^src/lib/ai/claudeClient\.js|^src/lib/ai/geminiClient\.js|^src/lib/ai/modelConfig\.js|^src/lib/ai/safetyFilter\.js|^src/lib/ai/promptStore\.js|^src/lib/ai/promptStoreText\.js|^src/lib/ai/moderationAgent\.js|^src/lib/ai/semanticClusters\.js|^src/lib/ai/builtinFallbackPrompt\.js|^src/lib/ai/era/|^src/app/api/auto/|^src/app/api/summarize/|^src/app/api/extract/|^src/app/api/research-search/|^src/app/api/queue/|^src/app/content/new/page\.js|^src/lib/correction/|^src/lib/input-engine/|^src/lib/workflow/workflowEngine\.js|^src/lib/agents/masterAgent\.js|^src/lib/persistStore\.js|^src/lib/utils/withTimeout\.js|^discord-bot/|^scripts/validate-workflow\.mjs|^scripts/news-lock-guard\.mjs$|^scripts/golden-lock/|^data/prompt-library\.json$|^src/lib/ai/cardAuthority\.js|^src/lib/ai/legacyLengthRules\.js|^src/lib/ai/promptModes\.js|^src/lib/ai/usageLogger\.js|^src/lib/services/cardEssences\.js|^src/lib/services/generationLogger\.js|^src/lib/services/rawFactCompletenessGate\.js|^src/lib/utils/publishablePostText\.js|^src/lib/utils/newsCap\.js|^src/lib/utils/objText\.js|^src/lib/utils/pipelineDeadline\.js|^src/lib/utils/researchSwitch\.js|^src/lib/utils/textCleaner\.js|^src/lib/pipelineLogger\.js|^src/lib/trace/blackbox\.js|^src/lib/db\.js|^src/lib/supabase\.js|^src/lib/auth\.js|^src/lib/logger\.js|^src/lib/scraper/|^src/lib/services/youtubeService\.js|^src/lib/services/tiktokService\.js|^src/lib/services/metaReelsService\.js|^src/lib/services/tavilyService\.js|^data/card-essences\.json$|^data/viral-essences\.json$'
APPROVAL='\[NEWS-LOCK-APPROVED'

zero=0000000000000000000000000000000000000000
blocked=0
pushing_main=0      # ★ 23 ก.ย. 69 ด่านเทสข่าว: มีการ push ไป refs/heads/main ในรอบนี้ไหม
pushed_shas=""
test_blocked=0

while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/main|refs/heads/version/golden-era) ;; *) continue;; esac
  [ "$local_sha" = "$zero" ] && continue          # ลบกิ่ง — ไม่เกี่ยว
  if [ "$remote_ref" = "refs/heads/main" ]; then   # ★ 23 ก.ย. 69 ด่านเทสข่าว (stdin ถูกลูปนี้อ่านหมด — จดไว้ใช้หลังลูป)
    pushing_main=1
    pushed_shas="$pushed_shas $local_sha"
  fi
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git rev-parse --verify -q origin/main || echo "")
  else
    base="$remote_sha"
  fi
  if [ -z "$base" ]; then
    range="$local_sha"
  else
    range="$base..$local_sha"
  fi
  # commit ในช่วงที่แตะไฟล์ล็อก
  for c in $(git rev-list $range 2>/dev/null); do
    # --diff-merges=first-parent: merge commit เทียบกับ parent แรกเท่านั้น (ค่าเริ่มต้น diff ของ merge = ว่าง → ตาบอด
    # ส่วน "-m --first-parent" ผิด: ยังรวม diff ของทุก parent → บล็อกผิด commit — พิสูจน์กับ 98d42a3 แล้ว)
    touched=$(git diff-tree --diff-merges=first-parent --no-commit-id --name-only -r "$c" | grep -E "$PROTECTED")
    [ -z "$touched" ] && continue
    if git log -1 --format=%B "$c" | grep -qE "$APPROVAL"; then
      continue
    fi
    if [ $blocked -eq 0 ]; then
      echo "=============================================================="
      echo "🔒🏆 GOLDEN-LOCK BLOCKED: push ไป main นี้แตะ 'ระบบเขียนข่าวยุคปัง' โดยไม่มีรหัสอนุมัติ"
      echo "=============================================================="
    fi
    blocked=1
    echo "⛔ commit $(git log -1 --format='%h %s' "$c" | cut -c1-90)"
    echo "$touched" | sed 's/^/      ↳ /'
  done
done

# ★ 23 ก.ย. 69 (แคมเปญแก้บั๊ก ข้อ 1 · เจ้าของอนุมัติ) — ด่านเทสข่าวก่อนขึ้น main (CFG-03: เทสข่าวแดงค้างบน main 16 วันไม่มีใครเห็น)
if [ "$pushing_main" = "1" ]; then
  if [ $blocked -eq 1 ]; then
    echo "ℹ️  ข้ามด่านเทสข่าวรอบนี้ — ติดรหัสอนุมัติอยู่แล้ว (แก้แล้ว push ใหม่ ด่านเทสจะรัน)"
  elif [ "$NEWS_TEST_GATE" = "0" ]; then
    echo "⚠️  NEWS_TEST_GATE=0 — ข้ามด่านเทสข่าว (สวิตช์ฉุกเฉิน) · ต้องรัน npm run test:news ให้เขียวตามหลังทันที"
  else
    top=$(git rev-parse --show-toplevel 2>/dev/null)
    if [ -z "$top" ] || [ ! -f "$top/scripts/test-news.mjs" ]; then
      echo "⚠️  ไม่พบ scripts/test-news.mjs ใน ${top:-worktree นี้} — ข้ามด่านเทสข่าว (กิ่งนี้ยังไม่มีตัวรัน)"
    elif ! command -v node >/dev/null 2>&1; then
      echo "⛔ ด่านเทสข่าว: ไม่พบคำสั่ง node ใน PATH — รันเทสไม่ได้"
      test_blocked=1
    else
      head_sha=$(git rev-parse HEAD 2>/dev/null)
      for s in $pushed_shas; do
        if [ "$s" != "$head_sha" ]; then
          echo "⚠️  commit ที่ push ($s) ไม่ใช่ HEAD ของ worktree นี้ — ผลเทสมาจากไฟล์บนดิสก์ ไม่ใช่ commit ที่ push"
        fi
      done
      if [ -n "$(git status --porcelain --untracked-files=no 2>/dev/null)" ]; then
        echo "⚠️  worktree มีไฟล์แก้ค้างที่ยังไม่ commit — ผลเทสรวมไฟล์เหล่านั้นด้วย"
      fi
      echo "🧪 ด่านเทสข่าว (push → main): node scripts/test-news.mjs"
      if ! (cd "$top" && node scripts/test-news.mjs); then
        test_blocked=1
      fi
    fi
  fi
fi

if [ $blocked -eq 1 ]; then
  echo ""
  echo "กติกา: ไฟล์ระบบข่าวถูกล็อกไว้ที่ยุคปัง (tag news-golden-era-23aug69) — แก้ได้เมื่อเจ้าของอนุมัติเท่านั้น"
  echo "ถ้าเจ้าของอนุมัติจริง: ใส่รหัสในข้อความ commit  [NEWS-LOCK-APPROVED by <ชื่อ> <วันที่>]  แล้ว push ใหม่"
  echo "ถ้าไม่ได้ตั้งใจแตะ: git checkout news-golden-era-23aug69 -- <ไฟล์> แล้ว commit ทับ"
  echo "ดูไฟล์ล็อกที่ commit หนึ่งแตะ: git diff-tree --diff-merges=first-parent --no-commit-id --name-only -r <commit> (เทียบรายการ PROTECTED ใน hook นี้)"
  echo "=============================================================="
  exit 1
fi
if [ $test_blocked -eq 1 ]; then
  echo "=============================================================="
  echo "🧪⛔ NEWS-TEST GATE BLOCKED: เทสระบบข่าวไม่ผ่าน — ไม่ให้ push ขึ้น main"
  echo "=============================================================="
  echo "ดูไฟล์ที่แดงด้านบน · รันซ้ำ: npm run test:news (หรือ node --test <ไฟล์>)"
  echo "แก้ที่ต้นเหตุ — ห้ามแก้ src เพื่อให้เทสผ่านโดยไม่เข้าใจสาเหตุ · เทสปก/คลิปอยู่นอกด่านนี้ (tests/news-suite.json → exclude)"
  echo "ฉุกเฉินจริงเท่านั้น (เจ้าของอนุมัติ): NEWS_TEST_GATE=0 git push ...  แล้วแก้เทสให้เขียวตามหลังทันที"
  echo "=============================================================="
  exit 1
fi
exit 0
